# =========================================================
# byclick.by — корневой .gitignore
# =========================================================

# ---------- Окружение ----------
.env
.env.*
!.env.example

# ---------- Зависимости / сборка ----------
/vendor
/node_modules
/public/build
/public/hot
/public/storage
/public/fonts-manifest.dev.json
/.vite

# ---------- Laravel: временные файлы ----------
/.phpunit.cache
/.phpunit.result.cache
.phpactor.json
/auth.json
/storage/*.key
/storage/pail
/storage/*.sqlite
/bootstrap/cache/*.php
/bootstrap/cache/*.php.tmp

# ---------- Базы данных ----------
/database/*.sqlite
/database/*.sqlite-journal
/database/*.sqlite-shm
/database/*.sqlite-wal

# ---------- Шаблон маркетплейса (.tpl) ----------
# Отдельный проект со своим git-репозиторием — в корневой репозиторий не входит
/.tpl/

# ---------- OSPanel (локальная конфигурация сервера) ----------
/.osp/nginx/
/.osp/*.log

# ---------- IDE ----------
/.fleet
/.idea
/.nova
/.vscode
/.zed

# ---------- AI-инструменты ----------
/.agents
/.amp
/.claude
/.codex
/.cursor
/.factory
/.grok
/.junie
/.kiro
/.pi
/.mcp.json
/AGENTS.md
/CLAUDE.md
/boost.json
/opencode.json
/opencode.jsonc

# ---------- Логи ----------
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ---------- Прочее ----------
Homestead.json
Homestead.yaml
.DS_Store
Thumbs.db
desktop.ini
~$*
/coverage
